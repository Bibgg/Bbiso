rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() >= 3 &&
             data.username is string &&
             data.username.size() >= 3 &&
             data.username.size() <= 30 &&
             (!('full_name' in data) || data.full_name is string) &&
             (!('display_name' in data) || data.display_name is string) &&
             (!('dob' in data) || data.dob is string) &&
             (!('avatar_url' in data) || data.avatar_url is string) &&
             (!('bio' in data) || data.bio is string) &&
             (!('phone_number' in data) || data.phone_number is string) &&
             (!('phone_or_email' in data) || data.phone_or_email is string) &&
             (!('private_account' in data) || data.private_account is bool);
    }

    function isValidPost(data) {
      return data.postId is string &&
             data.uid is string &&
             data.uid == request.auth.uid &&
             data.format in ['TUBE', 'SNAP', 'CHATTER', 'FORUM'] &&
             (!('caption' in data) || data.caption is string) &&
             (!('title' in data) || data.title is string) &&
             (!('mediaUrl' in data) || data.mediaUrl is string) &&
             (!('mediaType' in data) || data.mediaType in ['video', 'photo', 'none']) &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl is string) &&
             (!('cloudinaryPublicId' in data) || data.cloudinaryPublicId is string) &&
             (!('mediaBytes' in data) || data.mediaBytes is number) &&
             (!('durationSeconds' in data) || data.durationSeconds == null || data.durationSeconds is number) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
             (!('likesCount' in data) || data.likesCount is number) &&
             (!('commentsCount' in data) || data.commentsCount is number) &&
             (!('sharesCount' in data) || data.sharesCount is number);
    }

    function isValidChat(data) {
      return data.chatId is string &&
             data.participants is list &&
             data.participants.size() == 2 &&
             request.auth.uid in data.participants &&
             data.participants[0] != data.participants[1];
    }

    function isValidChatMessage(data, chatId) {
      return data.messageId is string &&
             data.chatId == chatId &&
             data.senderUid == request.auth.uid &&
             (!('text' in data) || (data.text is string && data.text.size() <= 5000)) &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 2048));
    }

    function isValidStory(data) {
      return data.storyId is string &&
             data.uid is string &&
             data.uid == request.auth.uid &&
             data.mediaUrl is string &&
             data.mediaUrl.matches('https://.*') &&
             data.mediaType in ['video', 'photo'] &&
             data.expiresAt is timestamp &&
             data.expiresAt > request.time &&
             data.expiresAt <= request.time + duration.value(24, 'h') &&
             (!('caption' in data) || (data.caption is string && data.caption.size() <= 2000)) &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl is string) &&
             (!('cloudinaryPublicId' in data) || data.cloudinaryPublicId is string);
    }

    match /stories/{storyId} {
      // Expired stories are never readable, even if a cleanup job has not removed the record yet.
      allow read: if resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time;
      allow create: if isAuthenticated() &&
                       request.resource.data.storyId == storyId &&
                       isValidStory(request.resource.data);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;

      match /views/{viewerUid} {
        allow create: if isAuthenticated() &&
                         viewerUid == request.auth.uid &&
                         exists(/databases/$(database)/documents/stories/$(storyId)) &&
                         get(/databases/$(database)/documents/stories/$(storyId)).data.expiresAt > request.time;
        allow read: if isAuthenticated() &&
                       exists(/databases/$(database)/documents/stories/$(storyId)) &&
                       (get(/databases/$(database)/documents/stories/$(storyId)).data.uid == request.auth.uid ||
                        viewerUid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      // Profile data can include phone number and date of birth: require sign-in.
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);

      match /likes/{postId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.postId == postId;
        allow delete: if isOwner(userId);
      }

      match /bookmarks/{postId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.postId == postId;
        allow delete: if isOwner(userId);
      }
    }

    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.username == username;
      allow update, delete: if isAuthenticated() &&
                               resource.data.uid == request.auth.uid &&
                               request.resource.data.uid == request.auth.uid &&
                               request.resource.data.username == username;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid &&
                       isValidPost(request.resource.data);
      allow update: if isAuthenticated() && (
                       resource.data.uid == request.auth.uid ||
                       (
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['likesCount', 'commentsCount', 'sharesCount']) &&
                         request.resource.data.uid == resource.data.uid &&
                         request.resource.data.postId == resource.data.postId
                       )
                    );
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() &&
                     request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
                       request.resource.data.chatId == chatId &&
                       isValidChat(request.resource.data);
      // A participant may update message preview metadata, never the participant list.
      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.participants &&
                       request.resource.data.participants == resource.data.participants &&
                       request.resource.data.chatId == resource.data.chatId &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastMessage', 'updatedAt']);
      // Preserve chat history; clients cannot delete the chat container.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
                       exists(/databases/$(database)/documents/chats/$(chatId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() &&
                         exists(/databases/$(database)/documents/chats/$(chatId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         isValidChatMessage(request.resource.data, chatId);
        allow update: if isAuthenticated() &&
                         resource.data.senderUid == request.auth.uid &&
                         request.resource.data.senderUid == resource.data.senderUid &&
                         request.resource.data.chatId == resource.data.chatId &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['text', 'mediaUrl']);
        allow delete: if isAuthenticated() && resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
