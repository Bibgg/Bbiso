rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Public media is readable for feed playback; only the owner can upload or delete.
    match /users/{userId}/videos/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) &&
        request.resource != null &&
        request.resource.size < 500 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/photos/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) &&
        request.resource != null &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/avatars/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) &&
        request.resource != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/profile.jpg {
      allow read: if true;
      allow create, update: if isOwner(userId) &&
        request.resource != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
